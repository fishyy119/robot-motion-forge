{
  "$defs": {
    "ControlFrame": {
      "additionalProperties": false,
      "description": "固定在连杆上的控制坐标系；原点可偏移，坐标轴与连杆对齐。",
      "if": {
        "required": [
          "trajectory_reference_body"
        ]
      },
      "properties": {
        "body": {
          "$ref": "#/$defs/Name",
          "description": "控制坐标系所附着的 MuJoCo 连杆名称"
        },
        "offset_m": {
          "$ref": "#/$defs/Vector3",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "description": "控制坐标系原点在连杆局部坐标中的位置，单位 m"
        },
        "support_polygon_cm": {
          "description": "足底接触轮廓顶点，控制坐标系局部坐标，单位 cm；至少三个共面且不共线的点",
          "items": {
            "$ref": "#/$defs/Vector3"
          },
          "title": "Support Polygon Cm",
          "type": "array"
        },
        "control_mode": {
          "$ref": "#/$defs/ControlMode",
          "default": "position",
          "description": "默认交互目标：位置、朝向或完整位姿；省略时为位置；可在界面中切换"
        },
        "fixed_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "新会话的默认固定分量：位置、朝向或完整位姿；省略时不固定"
        },
        "trajectory_mode": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlMode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "新工程的默认轨迹求解分量：位置、朝向或完整位姿；省略时禁用"
        },
        "trajectory_reference_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/Name"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "启用 trajectory_mode 后可指定轨迹参考连杆的 MuJoCo 名称。省略或设为 null 时使用世界坐标系。"
        }
      },
      "required": [
        "body"
      ],
      "then": {
        "properties": {
          "trajectory_mode": {
            "type": "string"
          }
        },
        "required": [
          "trajectory_mode"
        ]
      },
      "title": "ControlFrame",
      "type": "object"
    },
    "ControlMode": {
      "enum": [
        "position",
        "orientation",
        "pose"
      ],
      "type": "string"
    },
    "HomePose": {
      "additionalProperties": false,
      "properties": {
        "position_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Vector3"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "torso 初始位置，单位 m；省略时使用模型 qpos0"
        },
        "quaternion_wxyz": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quaternion"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "torso 初始朝向，wxyz；读入后归一化"
        },
        "joints_rad": {
          "additionalProperties": {
            "$ref": "#/$defs/Number"
          },
          "description": "hinge 关节初始角度，单位 rad",
          "propertyNames": {
            "$ref": "#/$defs/Name"
          },
          "title": "Joints Rad",
          "type": "object"
        },
        "joints_m": {
          "additionalProperties": {
            "$ref": "#/$defs/Number"
          },
          "description": "slide 关节初始位移，单位 m",
          "propertyNames": {
            "$ref": "#/$defs/Name"
          },
          "title": "Joints M",
          "type": "object"
        }
      },
      "title": "HomePose",
      "type": "object"
    },
    "JointRange": {
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        }
      ],
      "type": "array"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Name",
          "description": "机器人显示名称"
        },
        "repository_root": {
          "$ref": "#/$defs/Name",
          "description": "机器人仓库根目录；支持相对本定义的路径、~ 和环境变量"
        },
        "project_root": {
          "$ref": "#/$defs/Name",
          "description": "工程文件根目录；相对机器人仓库根目录解析，也支持绝对路径、~ 和环境变量"
        },
        "model": {
          "$ref": "#/$defs/Name",
          "description": "本地 MJCF 路径，支持单机器人模型或可提取单个机器人的场景；相对机器人仓库根目录解析，也支持绝对路径、~ 和环境变量"
        },
        "joint_limit_overrides": {
          "additionalProperties": {
            "$ref": "#/$defs/JointRange"
          },
          "description": "覆盖模型关节限位，值为 [下限, 上限]；hinge 使用 rad，slide 使用 m；未列出的关节沿用模型限位",
          "propertyNames": {
            "$ref": "#/$defs/Name"
          },
          "title": "Joint Limit Overrides",
          "type": "object"
        }
      },
      "required": [
        "name",
        "repository_root",
        "project_root",
        "model"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "Name": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "Number": {
      "type": "number"
    },
    "Quaternion": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        }
      ],
      "type": "array"
    },
    "Vector3": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        }
      ],
      "type": "array"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "可选的编辑器 JSON Schema 引用",
      "title": "$Schema"
    },
    "robot": {
      "$ref": "#/$defs/ModelConfig"
    },
    "home": {
      "$ref": "#/$defs/HomePose"
    },
    "frames": {
      "additionalProperties": {
        "$ref": "#/$defs/ControlFrame"
      },
      "description": "逻辑名称到控制坐标系定义的映射",
      "propertyNames": {
        "$ref": "#/$defs/Name"
      },
      "title": "Frames",
      "type": "object"
    },
    "joint_groups": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Name"
        },
        "type": "array"
      },
      "description": "界面中的关节分组；每个关节只能属于一个分组",
      "propertyNames": {
        "$ref": "#/$defs/Name"
      },
      "title": "Joint Groups",
      "type": "object"
    }
  },
  "required": [
    "robot"
  ],
  "title": "RobotDefinition",
  "type": "object",
  "allowComments": true,
  "allowTrailingCommas": true
}