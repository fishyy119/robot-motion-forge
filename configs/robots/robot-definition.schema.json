{
  "$defs": {
    "EndEffector": {
      "additionalProperties": false,
      "description": "固定在连杆上的末端坐标系；原点可偏移，坐标轴与连杆对齐。",
      "properties": {
        "body": {
          "$ref": "#/$defs/Name",
          "description": "末端坐标系所附着的 MuJoCo 连杆名称"
        },
        "offset_m": {
          "$ref": "#/$defs/Vector3",
          "default": [
            0.0,
            0.0,
            0.0
          ],
          "description": "末端坐标系原点在连杆局部坐标中的位置，单位 m"
        },
        "foot": {
          "default": false,
          "description": "是否为足部末端",
          "title": "Foot",
          "type": "boolean"
        },
        "support_polygon_cm": {
          "description": "足底接触轮廓顶点，末端局部坐标，单位 cm；至少三个共面且不共线的点",
          "items": {
            "$ref": "#/$defs/Vector3"
          },
          "title": "Support Polygon Cm",
          "type": "array"
        },
        "control_mode": {
          "description": "默认交互目标：位置、朝向或完整位姿；足部默认为完整位姿，其余末端默认为位置；可在界面中切换",
          "enum": [
            "position",
            "orientation",
            "pose"
          ],
          "title": "Control Mode",
          "type": "string"
        }
      },
      "required": [
        "body"
      ],
      "title": "EndEffector",
      "type": "object"
    },
    "HomePose": {
      "additionalProperties": false,
      "properties": {
        "position_m": {
          "anyOf": [
            {
              "$ref": "#/$defs/Vector3"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "初始根位置，单位 m；省略时使用模型 qpos0"
        },
        "quaternion_wxyz": {
          "anyOf": [
            {
              "$ref": "#/$defs/Quaternion"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "初始根方向，wxyz；读入后归一化"
        },
        "joints_rad": {
          "additionalProperties": {
            "$ref": "#/$defs/Number"
          },
          "description": "hinge 关节初始角度，单位 rad",
          "propertyNames": {
            "$ref": "#/$defs/Name"
          },
          "title": "Joints Rad",
          "type": "object"
        },
        "joints_m": {
          "additionalProperties": {
            "$ref": "#/$defs/Number"
          },
          "description": "slide 关节初始位移，单位 m",
          "propertyNames": {
            "$ref": "#/$defs/Name"
          },
          "title": "Joints M",
          "type": "object"
        }
      },
      "title": "HomePose",
      "type": "object"
    },
    "ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/$defs/Name",
          "description": "机器人显示名称"
        },
        "repository_root": {
          "$ref": "#/$defs/Name",
          "description": "机器人仓库根目录；支持相对本定义的路径、~ 和环境变量；工程默认保存在该目录的 .robot-motion-forge 子目录"
        },
        "model": {
          "$ref": "#/$defs/Name",
          "description": "本地纯机器人 MJCF 路径，不含地面等场景对象；支持相对本定义的路径、~ 和环境变量"
        },
        "root_body": {
          "$ref": "#/$defs/Name",
          "description": "MuJoCo 模型中的机器人根连杆名称"
        }
      },
      "required": [
        "name",
        "repository_root",
        "model",
        "root_body"
      ],
      "title": "ModelConfig",
      "type": "object"
    },
    "Name": {
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "Number": {
      "type": "number"
    },
    "Quaternion": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        }
      ],
      "type": "array"
    },
    "Vector3": {
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        },
        {
          "$ref": "#/$defs/Number"
        }
      ],
      "type": "array"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "可选的编辑器 JSON Schema 引用",
      "title": "$Schema"
    },
    "robot": {
      "$ref": "#/$defs/ModelConfig"
    },
    "home": {
      "$ref": "#/$defs/HomePose"
    },
    "end_effectors": {
      "additionalProperties": {
        "$ref": "#/$defs/EndEffector"
      },
      "description": "逻辑名称到末端坐标系定义的映射",
      "propertyNames": {
        "$ref": "#/$defs/Name"
      },
      "title": "End Effectors",
      "type": "object"
    },
    "joint_groups": {
      "additionalProperties": {
        "items": {
          "$ref": "#/$defs/Name"
        },
        "type": "array"
      },
      "description": "界面中的关节分组；每个关节只能属于一个分组",
      "propertyNames": {
        "$ref": "#/$defs/Name"
      },
      "title": "Joint Groups",
      "type": "object"
    }
  },
  "required": [
    "robot"
  ],
  "title": "RobotDefinition",
  "type": "object",
  "allowComments": true,
  "allowTrailingCommas": true
}